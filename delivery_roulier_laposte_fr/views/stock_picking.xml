<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_withcarrier_out_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field
            name="inherit_id"
            ref="delivery_carrier_option.view_picking_withcarrier_out_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//page//field[@name='option_ids']" position="after">
                <field name="display_insurance" invisible="1" />
                <field
                    name="laposte_recommande"
                    invisible="not display_insurance or delivery_type != 'laposte_fr'"
                />
                <field
                    name="laposte_insurance"
                    invisible="not display_insurance or delivery_type != 'laposte_fr'"
                />
            </xpath>
        </field>
    </record>
</odoo>
