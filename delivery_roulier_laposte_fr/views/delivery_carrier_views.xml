<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_delivery_carrier_form_laposte_fr" model="ir.ui.view">
        <field name="name">delivery.carrier.form.laposte.fr</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='title']" position="before">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="delivery_type != 'laposte_fr' or prod_environment"
                >
                    Colissimo has no test service. In the test environment, labels and tracking numbers are simulated and nothing is sent to Colissimo. Switch to the production environment to generate real labels.
                </div>
            </xpath>
        </field>
    </record>

</odoo>
